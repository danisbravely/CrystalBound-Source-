//// MAGIC ZONE !! ////

// A quick technical overview of what happens here:
/*
The table relocation is pretty standard stuff. No big deal there.

There are two major changes that colourful fades make:
    1. the slide speed is now only one byte instead of two.
       vanilla barely uses the low byte, so this change 
       does not make a noticable impact.
       The freed-up byte becomes our index into the colour table.
    
    2. WIPE_PALETTES_ON_MAP_LOAD ($7E4676) is no longer treated
       as a boolean. Instead, it contains the colour to wipe the
       palettes with. Previously, it would fill the palettes with
       white. It's only set in two places and read from in one.

The code for colourful fades is loosely based on the magic butterfly
effect, which implements its own fading loop. In fact, most fading stuff
across this game features a lot of very similar code: fill the current
palettes with the start colours, and put your end palettes in the buffer.
Then call the function that prepares the linear interpolation values,
then loop while stepping the fade and waiting frames.

A sister script to this one is also on the library that provides
some standardised functions to do this sort of thing, along with
a control code example implementation. It's called "fade tools".

*/

// Table relocation
// in $C06662 ScreenTransition
ROM[0xC06671] = ASMLoadAddress06 (ExpandedWarpStyles)
// in $C068AF GetScreenTransitionSoundEffect
ROM[0xC068BB] = ASMLoadAddress06 (ExpandedWarpStyles)

// Macros
command WarpStyle(duration, swirl, swirl_flags,
                  fade, direction, colour, slide_speed,
                  sfx, second_duration, second_swirl,
                  second_swirl_flags, second_sfx)
{
    byte duration byte swirl byte swirl_flags
    byte fade byte direction byte colour byte slide_speed
    byte sfx byte second_duration byte second_swirl
    byte second_swirl_flags byte second_sfx
}
command FadeColour(colour) { short colour }

// Patches
define FinishPaletteFade = 0xC49740
define BackgroundSlideInit = 0xC42631
define BUFFER = 0x7F0000
define PALETTES = 0x7E0200
define WIPE_PALETTES_ON_MAP_LOAD = 0x4676

// patches to support colourful fades during screen transitions
ROM[0xC0673D] = { JML (ColourfulFadeOutPatch) }
ROM[0xC06786] = { JML (ColourfulPostFadeOutPatch) NOP }
ROM[0xC067E9] = { JML (ColourfulFadeInPatch) NOP NOP NOP NOP }
// patches for the new functionality of WIPE_PALETTES_ON_MAP_LOAD
ROM[0xC067C5] = { JML (ColourfulWipePalettesScreenTransitionPatch) NOP NOP }
ROM[0xC00A60] = { JML (ColourfulWipePalettesLoadMapPatch) }
// the only other place that WIPE_PALETTES_ON_MAP_LOAD is set.
// set it to white becuase that's what this being nonzero used to do
ROM[0xC4C772] = { LDA_i (0x7FFF) }
// patching slide speed to only use the high byte
ROM[0xC066BC] = { JML (ColourfulSlideSpeedPatch) }

ColourfulFadeOutPatch: {
    PHA
    LDY_i (5) // where slide speed used to start
    LDA_dly (6)
    AND_i (0x00FF) // low byte is colour index
    BNE_a (_hasColour)
    // no colour, exit
    PLA
    JSL (0xC4954C)
    BRA_a (_return)

_hasColour:
    // Fill the buffer with the colour (target palettes)
    // But all in registers+stack because idc to figure out locals

    // A = colour index
    ASL // *2 because it's a short
    TAX
    LDA_xl (FadeColourTable)
    // A = colour

    LDX_i (0)
    // X = loop
    BRA_a (_checkBufferFillLoop)
_bufferFillLoop:
        // A = colour, X = loop
        TAY // colour --> Y
        TXA // loop --> A
        ASL // create index
        PHX // loop --> stack
        PHA // index --> stack
        TYA // A = colour
        PLX // X = index
        STA_xl (0x7F0000) // store in buffer
        PLX // X = loop
        INX // loop++
_checkBufferFillLoop:
        CPX_i  (0x0100)
        BCC_a  (_bufferFillLoop)
    
    PLA // restore stack
    
_return:
    JML (0xC06741) // return to original code
}


ColourfulPostFadeOutPatch: {
    LDY_i (5) // where slide speed used to start
    LDA_dly (6)
    AND_i (0x00FF) // low byte is colour index
    CMP_i (0)
    BNE_a (_hasColour)
    // no colour, exit
    // vanilla code that we patched over
    SEP (0x20)
    LDY_i (3)
    // return
    JML (0xC0678B)

_hasColour:
    // can't help but wonder why they didn't just use this 
    JSL (FinishPaletteFade)
    // return
    JML (0xC067C1)
}


ColourfulFadeInPatch: {
    // previously the functionality here
    // was {if (fadeMultiplier <= 50) do fadeIn else do generic fade stuff}
    // now the condition needs to be (fadeMultiplier <= 50 & colour == 0)

    // we'd just subtracted the fade multiplier from 50,
    // so this is the branch check
    // it's (overflow XNOR negative)
    // (a BRANCHLTEQS in ebsrc)
    BVC_a (_bmi)
    BPL_a (_false)
    BRA_a (_true)
    _bmi:
    BMI_a (_false)

    _true: // fade mult is <= 50
    // check that colour is also zero
    LDY_i (5) // where slide speed used to start
    LDA_dly (6)
    AND_i (0x00FF) // low byte is colour index
    CMP_i (0)
    BNE_a (_false)
    // good! return to original code with truth
    LDX_i (1)
    JML (0xC067F4)

    _false: // fade mult is > 50 and colour != 0
    // return to original code with evil lies
    LDX_i (0)
    JML (0xC067F4)
}


ColourfulWipePalettesScreenTransitionPatch: {
    LDY_i (5) // where slide speed used to start
    LDA_dly (6)
    AND_i (0x00FF) // low byte is colour index
    CMP_i (0)
    BNE_a (_hasColour)
    // no colour, but don't return just yet!
    BRA_a (_noColour)

_hasColour:
    // A = colour index
    ASL // *2 because it's a short
    TAX
    LDA_xl (FadeColourTable)
    // A = colour
    STA_a (WIPE_PALETTES_ON_MAP_LOAD)
    BRA_a (_return)

_noColour:
    // if we got to this point at all,
    // it means that the fade mult is > 50
    // so if no colour was specified we still
    // need to store white to WIPE_PALETTES_ON_MAP_LOAD
    LDA_i (0x7FFF)
    STA_a (WIPE_PALETTES_ON_MAP_LOAD)

_return:
    JML (0xC067CB)  
}


ColourfulWipePalettesLoadMapPatch: {
    // instead of filling the palettes with white,
    // fill them with the colour value.
    LDA_a (WIPE_PALETTES_ON_MAP_LOAD)
    LDX_i (0)
    // X = loop
    BRA_a (_checkPaletteFillLoop)
_paletteFillLoop:
        // A = colour, X = loop
        TAY // colour --> Y
        TXA // loop --> A
        ASL // create index
        PHX // loop --> stack
        PHA // index --> stack
        TYA // A = colour
        PLX // X = index
        STA_x (PALETTES) // store in palettes
        PLX // X = loop
        INX // loop++
_checkPaletteFillLoop:
        CPX_i  (0x0100)
        BCC_a  (_paletteFillLoop)

    JML (0xC00A72) // return
}

ColourfulSlideSpeedPatch: {
    // we have the low byte (now colour) and high byte loaded
    // so just clear the low byte
    AND_i (0xFF00)

    // function we overwrote
    JSL (BackgroundSlideInit)

    // back to the original code
    JML (0xC066C0)
}