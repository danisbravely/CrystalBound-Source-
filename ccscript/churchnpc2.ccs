message:
	"@{name(1)} sweetie, is that you?" next
	"@Oh you've gone and grown up on me haven't you!" next
	"@What? You remember me, dont'cha!?" next 
	"@Aw, don't worry about it hun, you were just too young to remmber," next 
	"@I'm an old friend of your Mama's, I used to babysit you when you were real little!" next
	"@I moved out of town around 15 years ago so I haven't seen your or your Mama in a long time.." next 
	"@Haven't heard from her lately either, is she doing alright, honey?" next
	"@..." next
	"@It's okay, you don't have to answer that if you don't want to." next 
	"@I understand."
	end 